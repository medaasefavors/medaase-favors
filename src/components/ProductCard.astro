---
import ProductVisual from './ProductVisual.astro';
import { startsFrom, type Product } from '../data/products';
import { cedi } from '../lib/format';
import { url } from '../lib/url';
interface Props { product: Product; headingLevel?: 'h2' | 'h3' }
const { product, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---
<article class="pc card" data-category={product.category}>
  <a href={url(`/products/${product.slug}`)} class="pc__link">
    <div class="pc__media"><ProductVisual slug={product.slug} alt={product.imageAlt} /></div>
    <H class="pc__name">{product.name}</H>
    <p class="pc__blurb">{product.blurb}</p>
    <p class="price"><small>Starts from</small>{cedi(startsFrom(product.slug))}</p>
  </a>
</article>
<style>
  .pc { padding: 14px; transition: transform 0.25s ease, box-shadow 0.25s ease; }
  .pc:hover { transform: translateY(-6px) rotate(-0.6deg); }
  .pc:hover .pc__media :global(svg) { transform: scale(1.05); }
  .pc__link { text-decoration: none; display: flex; flex-direction: column; height: 100%; }
  .pc__media { border-radius: 18px; overflow: hidden; margin-bottom: 16px; background: linear-gradient(160deg, var(--pink-soft), #fff 70%); }
  .pc__media :global(svg) { transition: transform 0.4s ease; width: 100%; }
  .pc__name { font-size: 1.3rem; margin: 0 6px 6px; }
  .pc__blurb { margin: 0 6px 12px; color: var(--muted); font-size: 0.98rem; }
  .price { margin: auto 6px 6px; }
</style>
