---
// Medaase Favors gift tag logo (final). Files live in public/brand/.
// variant: 'on-navy' (pink tag, for the navy header and footer), 'primary' (navy tag, for white),
// 'on-pink' (navy tag, white ribbon), 'icon' (square app icon).
import { url } from '../lib/url';
interface Props { height?: number; variant?: 'on-navy' | 'primary' | 'on-pink' | 'icon'; class?: string }
const { height = 44, variant = 'on-navy', class: cls } = Astro.props;
const file = variant === 'icon' ? 'icon.svg' : `logo-${variant}.svg`;
const width = variant === 'icon' ? height : Math.round((height * 420) / 180);
---
<img src={url(`/brand/${file}`)} width={width} height={height} alt="Medaase Favors" class={cls} decoding="async" />
