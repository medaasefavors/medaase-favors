---
// Medaase Favors logo from the brand kit (src/assets/brand).
// variant: primary (on white), on-navy, on-pink, mono-white, mono-navy.
import primary from '../assets/brand/logo-primary.svg';
import onNavy from '../assets/brand/logo-on-navy.svg';
import onPink from '../assets/brand/logo-on-pink.svg';
import monoWhite from '../assets/brand/logo-mono-white.svg';
import monoNavy from '../assets/brand/logo-mono-navy.svg';
type Variant = 'primary' | 'on-navy' | 'on-pink' | 'mono-white' | 'mono-navy';
interface Props { variant?: Variant; height?: number; decorative?: boolean }
const { variant = 'primary', height = 48, decorative = false } = Astro.props;
const map = { primary, 'on-navy': onNavy, 'on-pink': onPink, 'mono-white': monoWhite, 'mono-navy': monoNavy };
const img = map[variant];
const width = Math.round((height * 406) / 132);
---
<img src={img.src} width={width} height={height} alt={decorative ? '' : 'Medaase Favors'} class="logo" decoding="async" />
