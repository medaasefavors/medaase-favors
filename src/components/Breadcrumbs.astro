---
import { url } from '../lib/url';
interface Props { items: { name: string; path: string }[] }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="bc">
  <ol>
    {items.map((it, i) => (
      <li>{i < items.length - 1 ? <a href={url(it.path)}>{it.name}</a> : <span aria-current="page">{it.name}</span>}</li>
    ))}
  </ol>
</nav>
<style>
  .bc ol { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; padding: 0; margin: 0 0 20px; font-size: 0.95rem; color: var(--muted); }
  .bc li + li::before { content: '/'; margin-right: 6px; }
  .bc a { text-decoration: none; }
  .bc a:hover { text-decoration: underline; }
</style>
