---
// Placeholder visual until real product photos and the 3D posters arrive (Phase 3).
// Deliberately typographic only: the brand rules forbid flat illustrations.
import { getProduct } from '../data/products';
interface Props { slug: string; alt: string; tall?: boolean }
const { slug, alt, tall = false } = Astro.props;
const p = getProduct(slug)!;
const words = p.shortName.split(' ');
const h = tall ? 520 : 300;
const gid = `g-${slug}`;
---
<svg viewBox={`0 0 400 ${h}`} width="400" height={h} role="img" aria-label={alt}>
  <defs>
    <linearGradient id={gid} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#FFE3EE" />
      <stop offset="0.55" stop-color="#FFB8D1" />
      <stop offset="1" stop-color="#1B2A4E" stop-opacity="0.85" />
    </linearGradient>
  </defs>
  <rect width="400" height={h} fill={`url(#${gid})`} />
  {words.map((w, i) => (
    <text x="28" y={h - 40 - (words.length - 1 - i) * 52} font-family="Young Serif, Georgia, serif" font-size="50" fill="#FFFFFF">{w}</text>
  ))}
  <text x="28" y="48" font-family="DM Sans, sans-serif" font-size="15" font-weight="700" letter-spacing="2.5" fill="#1B2A4E">MEDAASE FAVORS</text>
</svg>
