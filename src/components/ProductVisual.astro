---
// Real photo when we have one; otherwise a typographic brand placeholder
// (the brand rules forbid flat illustrations).
import { Picture } from 'astro:assets';
import { getProduct } from '../data/products';
import { PRODUCT_PHOTOS } from '../data/photos';
interface Props { slug: string; alt: string; tall?: boolean; eager?: boolean }
const { slug, alt, tall = false, eager = false } = Astro.props;
const p = getProduct(slug)!;
const photo = PRODUCT_PHOTOS[slug];
const words = p.shortName.split(' ');
const h = tall ? 520 : 300;
const gid = `g-${slug}`;
---
{photo ? (
  <Picture
    src={photo.src}
    alt={photo.alt}
    formats={['avif', 'webp']}
    widths={tall ? [480, 800, 1100] : [320, 480, 640]}
    sizes={tall ? '(min-width: 960px) 560px, 100vw' : '(min-width: 1000px) 280px, (min-width: 640px) 45vw, 100vw'}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    class:list={['pv-photo', { 'pv-photo--tall': tall }]}
  />
) : (
  <svg viewBox={`0 0 400 ${h}`} width="400" height={h} role="img" aria-label={alt}>
    <defs>
      <linearGradient id={gid} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#FFE3EE" />
        <stop offset="0.55" stop-color="#FFB8D1" />
        <stop offset="1" stop-color="#1B2A4E" stop-opacity="0.85" />
      </linearGradient>
    </defs>
    <rect width="400" height={h} fill={`url(#${gid})`} />
    {words.map((w, i) => (
      <text x="28" y={h - 40 - (words.length - 1 - i) * 52} font-family="DM Sans, sans-serif" font-weight="700" font-size="48" fill="#FFFFFF">{w}</text>
    ))}
    <text x="28" y="48" font-family="DM Sans, sans-serif" font-size="15" font-weight="700" letter-spacing="2.5" fill="#1B2A4E">MEDAASE FAVORS</text>
  </svg>
)}
<style>
  :global(.pv-photo) { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; }
  :global(.pv-photo--tall) { aspect-ratio: 400 / 520; }
</style>
