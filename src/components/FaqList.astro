---
// Accordion of questions. Works with no JavaScript (native <details>).
// `group` makes it exclusive: opening one question closes the others in the same group.
interface Props { faqs: { q: string; a: string }[]; headingLevel?: 'h2' | 'h3'; group?: string }
const { faqs, headingLevel = 'h3', group = 'faq' } = Astro.props;
const H = headingLevel;
---
<div class="acc">
  {faqs.map((f) => (
    <details class="acc__item" name={group}>
      <summary class="acc__q">
        <H class="acc__title">{f.q}</H>
        <span class="acc__icon" aria-hidden="true"></span>
      </summary>
      <div class="acc__a"><p>{f.a}</p></div>
    </details>
  ))}
</div>

<style>
  .acc {
    max-width: 820px;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .acc__item + .acc__item {
    border-top: 1px solid var(--line);
  }
  .acc__q {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
    padding: 6px 20px 6px 24px;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .acc__q::-webkit-details-marker {
    display: none;
  }
  .acc__q:hover {
    background: var(--pink-soft);
  }
  .acc__q:focus-visible {
    outline-offset: -3px;
  }
  .acc__title {
    font-family: var(--body);
    font-weight: 700;
    font-size: 1.06rem;
    line-height: 1.35;
    letter-spacing: 0;
    margin: 12px 0;
  }
  .acc__icon {
    position: relative;
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--pink);
    transition: transform 0.3s ease, background 0.3s ease;
  }
  .acc__icon::before,
  .acc__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 2px;
    border-radius: 2px;
    background: var(--navy);
    transform: translate(-50%, -50%);
  }
  .acc__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  .acc__item[open] .acc__icon {
    transform: rotate(45deg);
    background: var(--navy);
  }
  .acc__item[open] .acc__icon::before,
  .acc__item[open] .acc__icon::after {
    background: var(--white);
  }
  .acc__a {
    padding: 0 24px 20px;
    color: var(--muted);
    max-width: 68ch;
  }
  .acc__a p {
    margin: 0;
  }
  /* Smooth open and close where the browser supports it */
  @supports (interpolate-size: allow-keywords) {
    .acc {
      interpolate-size: allow-keywords;
    }
    .acc__item::details-content {
      height: 0;
      overflow: hidden;
      transition: height 0.3s ease, content-visibility 0.3s allow-discrete;
    }
    .acc__item[open]::details-content {
      height: auto;
    }
  }
</style>
