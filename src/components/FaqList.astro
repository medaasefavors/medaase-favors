---
interface Props { faqs: { q: string; a: string }[]; headingLevel?: 'h2' | 'h3' }
const { faqs, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---
<div class="faq">
  {faqs.map((f) => (
    <details>
      <summary><H>{f.q}</H></summary>
      <p>{f.a}</p>
    </details>
  ))}
</div>
<style>
  .faq { display: grid; gap: 12px; max-width: 820px; }
  .faq details { background: var(--glass); border: 1px solid var(--line); border-radius: 18px; padding: 4px 20px; }
  .faq summary { cursor: pointer; list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 56px; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; font-size: 1.6rem; line-height: 1; flex: none; }
  .faq details[open] summary::after { content: '–'; }
  .faq summary :global(h2), .faq summary :global(h3) { font-family: var(--body); font-weight: 700; font-size: 1.08rem; margin: 12px 0; line-height: 1.35; }
  .faq p { margin: 0 0 16px; color: var(--muted); }
</style>
