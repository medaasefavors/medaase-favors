---
import Logo from './Logo.astro';
import { EVENTS } from '../data/site';
import { url } from '../lib/url';

const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const is = (p: string) => (p === '/' ? path === '/' : path.startsWith(p));
---
<header class="hdr">
  <div class="wrap hdr__in">
    <a href={url('/')} class="hdr__brand" aria-label="Medaase Favors home">
      <Logo height={56} variant="primary" />
    </a>

    <nav class="hdr__nav" aria-label="Main">
      <a href={url('/')} aria-current={is('/') ? 'page' : undefined}>Home</a>
      <a href={url('/products')} aria-current={is('/products') ? 'page' : undefined}>All products</a>
      <details class="dd">
        <summary>Souvenirs for</summary>
        <ul>
          {EVENTS.map((e) => <li><a href={url(`/souvenirs/${e.slug}`)}>{e.name}</a></li>)}
        </ul>
      </details>
      <a href={url('/how-it-works')} aria-current={is('/how-it-works') ? 'page' : undefined}>How it works</a>
      <a href={url('/faq')} aria-current={is('/faq') ? 'page' : undefined}>FAQ</a>
    </nav>

    <a href={url('/checkout')} class="hdr__cart" aria-label="Your order">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 7h12l-1 13H7L6 7Z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
      <span>Order</span>
      <span class="hdr__count" data-cart-count hidden>0</span>
    </a>

    <details class="mm">
      <summary class="mm__btn">Menu</summary>
      <div class="mm__panel">
        <nav aria-label="Mobile">
          <a href={url('/')}>Home</a>
          <a href={url('/products')}>All products</a>
          <p class="mm__label">Souvenirs for</p>
          {EVENTS.map((e) => <a class="mm__sub" href={url(`/souvenirs/${e.slug}`)}>{e.name}</a>)}
          <a href={url('/how-it-works')}>How it works</a>
          <a href={url('/faq')}>FAQ</a>
          <a href={url('/contact')}>Contact</a>
          <a href={url('/checkout')} class="btn">Your order</a>
        </nav>
      </div>
    </details>
  </div>
</header>

<script is:inline>
  (function () {
    try {
      var cart = JSON.parse(localStorage.getItem('mf-cart') || '[]');
      var n = Array.isArray(cart) ? cart.length : 0;
      if (n > 0) {
        document.querySelectorAll('[data-cart-count]').forEach(function (el) {
          el.textContent = String(n);
          el.hidden = false;
        });
      }
    } catch (e) {}
  })();
</script>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.78);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    border-bottom: 1px solid var(--line);
  }
  .hdr__in {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 68px;
  }
  .hdr__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    margin-right: auto;
  }
  .hdr__name {
    font-family: var(--display);
    font-size: 1.25rem;
  }
  .hdr__name em {
    font-family: var(--body);
    font-style: italic;
    font-weight: 500;
  }
  .hdr__nav {
    display: none;
    align-items: center;
    gap: 4px;
  }
  .hdr__nav > a,
  .dd summary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 500;
    cursor: pointer;
  }
  .hdr__nav > a:hover,
  .dd summary:hover,
  .hdr__nav > a[aria-current='page'] {
    background: var(--pink-soft);
  }
  .dd {
    position: relative;
  }
  .dd summary {
    list-style: none;
  }
  .dd summary::-webkit-details-marker {
    display: none;
  }
  .dd summary::after {
    content: '';
    width: 7px;
    height: 7px;
    margin-left: 8px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
  }
  .dd ul {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 230px;
    list-style: none;
    margin: 0;
    padding: 8px;
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid var(--line);
    border-radius: 18px;
    box-shadow: var(--shadow);
  }
  .dd li a {
    display: block;
    padding: 10px 14px;
    border-radius: 12px;
    text-decoration: none;
  }
  .dd li a:hover {
    background: var(--pink-soft);
  }
  .hdr__cart {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    background: var(--navy);
    color: var(--white);
    text-decoration: none;
    font-weight: 700;
  }
  .hdr__count {
    background: var(--pink);
    color: var(--navy);
    border-radius: 999px;
    min-width: 22px;
    height: 22px;
    display: inline-grid;
    place-items: center;
    font-size: 0.8rem;
    padding: 0 6px;
  }
  .hdr__count[hidden] {
    display: none;
  }
  .mm__btn {
    list-style: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    border: 2px solid var(--navy);
    font-weight: 700;
    cursor: pointer;
  }
  .mm__btn::-webkit-details-marker {
    display: none;
  }
  .mm[open] .mm__btn {
    position: relative;
    z-index: 61;
    background: var(--navy);
    color: var(--white);
  }
  .mm__panel {
    position: fixed;
    inset: 0;
    z-index: 60;
    padding: 90px var(--gutter) 40px;
    overflow-y: auto;
    background: rgba(255, 227, 238, 0.86);
    backdrop-filter: blur(22px) saturate(1.5);
    -webkit-backdrop-filter: blur(22px) saturate(1.5);
  }
  .mm__panel nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .mm__panel a:not(.btn) {
    font-family: var(--display);
    font-size: 1.7rem;
    text-decoration: none;
    padding: 8px 0;
  }
  .mm__panel a.mm__sub {
    font-family: var(--body);
    font-size: 1.1rem;
    padding: 8px 0 8px 14px;
  }
  .mm__label {
    margin: 12px 0 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .mm__panel .btn {
    margin-top: 20px;
    align-self: flex-start;
  }
  @media (max-width: 420px) {
    .hdr__cart span:not(.hdr__count) {
      display: none;
    }
    .hdr__name {
      font-size: 1.05rem;
    }
  }
  @media (min-width: 1000px) {
    .hdr__nav {
      display: flex;
    }
    .mm {
      display: none;
    }
    .hdr__brand {
      margin-right: 0;
    }
    .hdr__nav {
      margin: 0 auto;
    }
  }
</style>
