---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductVisual from '../../components/ProductVisual.astro';
import ProductCard from '../../components/ProductCard.astro';
import FaqList from '../../components/FaqList.astro';
import Illus from '../../components/Illus.astro';
import {
  PRODUCTS, ADD_ONS, CARD_SHAPES, CARD_DESIGNS, sizesOf, startsFrom, highestUnit, containerName, type Product,
} from '../../data/products';
import { SITE } from '../../data/site';
import { cedi } from '../../lib/format';
import { absolute, url } from '../../lib/url';
import { breadcrumbs, faqPage } from '../../lib/schema';
import { PRODUCT_PHOTOS, packshotsFor } from '../../data/photos';
import { Picture } from 'astro:assets';

export function getStaticPaths() {
  return PRODUCTS.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

const { product: p } = Astro.props as { product: Product };
const sizes = sizesOf(p.slug);
const from = startsFrom(p.slug);
const path = `/products/${p.slug}`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'All products', path: '/products' },
  { name: p.name, path },
];
const allContainers = p.packaging.flatMap((pk) => pk.colours.map((c) => containerName(pk, c)));
const shots = packshotsFor(p.slug, allContainers);
const others = PRODUCTS.filter((x) => x.slug !== p.slug).slice(0, 3);
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  description: p.description,
  image: [absolute('/og/default.png')],
  brand: { '@type': 'Brand', name: SITE.name },
  url: absolute(path),
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'GHS',
    lowPrice: from,
    highPrice: highestUnit(p.slug),
    offerCount: sizes.length,
    availability: 'https://schema.org/InStock',
    seller: { '@id': absolute('/') + '#organization' },
  },
};
const title = `${p.shortName} Souvenirs in Ghana | Medaase Favors`;
const desc = `${p.name} souvenirs personalised with your names or logo and event date. Starts from ${cedi(from)} per piece, from ${SITE.minPerItem} pieces. Free label design.`;
---
<Base title={title} description={desc.slice(0, 155)} path={path} schema={[productSchema, breadcrumbs(crumbs), faqPage(p.faqs)]} ogType="product">
  <section class="section pp">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <div class="pp__grid">
        <div class="pp__media">
          <div class="pp__stage card" data-stage>
            <div class="pp__shot is-on" data-shot=""><ProductVisual slug={p.slug} alt={p.imageAlt} tall eager /></div>
            {shots.map((s) => (
              <div class="pp__shot pp__shot--pack" data-shot={s.container} data-area={s.area ? JSON.stringify(s.area) : undefined}>
                <Picture src={s.photo.src} alt={s.photo.alt} formats={['webp']} widths={[1200]} sizes="(min-width: 960px) 560px, 100vw" loading="lazy" class="pv-photo pv-photo--tall" />
                {s.area && <canvas class="pp__paint" aria-hidden="true" hidden></canvas>}
              </div>
            ))}
          </div>
          <p class="pp__lpcap" data-lpcap hidden>Your label</p>
          <div class="pp__labelprev" data-labelprev aria-live="polite" hidden>
            <span class="pp__lp-front" data-lp-front>Your names</span>
            <span class="pp__lp-date" data-lp-date></span>
          </div>
        </div>

        <div class="pp__info">
          <h1>{p.name}</h1>
          <p class="price pp__price"><small>Starts from</small>{cedi(from)} <span>per piece</span></p>
          <p class="lede">{p.description}</p>
          {p.kicker && <p class="pp__kicker">{p.kicker}</p>}
          <ul class="pills">
            <li class="pill">From {SITE.minPerItem} pieces</li>
            <li class="pill">Free label design</li>
            <li class="pill">Ready in {SITE.turnaround}</li>
          </ul>

          <form class="opts flow" data-form data-slug={p.slug} data-card-sizes={JSON.stringify(p.cardMount ? p.cardMountSizes : [])} novalidate>
            <p class="flow__intro">Let's make your favours. A few quick questions and you're done.</p>

            <section class="step" data-step="size" aria-labelledby="q-size">
              <h2 class="step__q" id="q-size">Which size would you like?</h2>
              <p class="step__a" data-answer hidden><span data-answer-text></span> <button type="button" class="step__change" data-change>Change</button></p>
              <div class="step__body opts__row" role="radiogroup" aria-labelledby="q-size">
                {sizes.map((s, i) => (
                  <label class="opt"><input type="radio" name="size" value={s.size} checked={i === 0} /><span>{s.size}<b>{cedi(s.price)} each</b></span></label>
                ))}
              </div>
            </section>

            {p.shades && p.shades.length > 0 && (
              <section class="step" data-step="shade" aria-labelledby="q-shade">
                <h2 class="step__q" id="q-shade">Which shade?</h2>
                <p class="step__a" data-answer hidden><span data-answer-text></span> <button type="button" class="step__change" data-change>Change</button></p>
                <div class="step__body opts__row" role="radiogroup" aria-labelledby="q-shade">
                  {p.shades.map((s) => <label class="opt opt--shade"><input type="radio" name="shade" value={s.name} /><span><i class="swatch" style={`background:${s.swatch}`} aria-hidden="true"></i>{s.name}<b>{s.note}</b></span></label>)}
                </div>
              </section>
            )}

            {p.scents.length > 0 && (
              <section class="step" data-step="scent" aria-labelledby="q-scent">
                <h2 class="step__q" id="q-scent">Which scent?</h2>
                <p class="step__a" data-answer hidden><span data-answer-text></span> <button type="button" class="step__change" data-change>Change</button></p>
                <div class="step__body opts__row" role="radiogroup" aria-labelledby="q-scent">
                  {p.scents.map((s, i) => <label class="opt"><input type="radio" name="scent" value={s} checked={i === 0} /><span>{s}</span></label>)}
                </div>
              </section>
            )}

            {p.packaging.length > 1 && (
              <section class="step" data-step="packaging" aria-labelledby="q-pack">
                <h2 class="step__q" id="q-pack">What should it come in?</h2>
                <p class="step__a" data-answer hidden><span data-answer-text></span> <button type="button" class="step__change" data-change>Change</button></p>
                <div class="step__body opts__row" role="radiogroup" aria-labelledby="q-pack">
                  {p.packaging.map((pk, i) => <label class="opt"><input type="radio" name="packaging" value={pk.type} data-label-style={pk.labelStyle} checked={i === 0} /><span>{pk.type}</span></label>)}
                </div>
              </section>
            )}

            <section class="step" data-step="colour" aria-labelledby="q-colour">
              <h2 class="step__q" id="q-colour" data-colour-q>{p.packaging.length === 1 ? `Which ${p.packaging[0].type.toLowerCase()} colour?` : `Which ${p.packaging[0].type.toLowerCase().split(' ').pop()} colour?`}</h2>
              <p class="step__a" data-answer hidden><span data-answer-text></span> <button type="button" class="step__change" data-change>Change</button></p>
              <div class="step__body">
                {p.packaging.map((pk, i) => (
                  <div data-for-pack={pk.type} hidden={i !== 0}>
                    <div class="opts__row" role="radiogroup" aria-labelledby="q-colour">
                      {pk.colours.map((c) => {
                        const out = (pk.outOfStock ?? []).includes(c);
                        const firstIn = pk.colours.find((x) => !(pk.outOfStock ?? []).includes(x));
                        return <label class:list={['opt', { 'is-disabled': out }]}><input type="radio" name="container" value={containerName(pk, c)} data-pack={pk.type} data-colour={c} data-label-style={pk.labelStyle} checked={i === 0 && c === firstIn} disabled={out} /><span>{c}{out && <small>Out of stock</small>}</span></label>;
                      })}
                    </div>
                    {pk.lids.length > 0 && (
                      <>
                        <p class="opts__sub">And the lid?</p>
                        <div class="opts__row">
                          {pk.lids.map((l, j) => <label class="opt"><input type="radio" name="lid" value={l} checked={j === 0} disabled={i !== 0} /><span>{l}</span></label>)}
                        </div>
                      </>
                    )}
                    {pk.labelStyle === 'lid' && <p class="field__hint">Labels on aluminium jars are round and go on the lid.</p>}
                  </div>
                ))}
              </div>
            </section>

            <section class="step" data-step="label" aria-labelledby="q-label">
              <h2 class="step__q" id="q-label">Would you like a label with your names or logo?</h2>
              <p class="step__a" data-answer hidden><span data-answer-text></span> <button type="button" class="step__change" data-change>Change</button></p>
              <div class="step__body">
                <div class="opts__row opts__row--big" role="radiogroup" aria-labelledby="q-label">
                  <label class="opt opt--big"><input type="radio" name="label" value="yes" /><span><strong>Yes, add a label</strong>Names or logo, with the date. +{cedi(ADD_ONS.label)} each</span></label>
                  <label class="opt opt--big"><input type="radio" name="label" value="none" checked /><span><strong>No label</strong>Just the product.</span></label>
                </div>
                <div class="opts__label" data-label-fields>
                  <div class="opts__row" role="radiogroup" aria-label="Front of the label">
                    <label class="opt"><input type="radio" name="front" value="text" checked /><span>Type names</span></label>
                    <label class="opt"><input type="radio" name="front" value="logo" /><span>Upload a logo</span></label>
                  </div>
                  <label class="field" data-front-text>What should the label say? (up to 32 characters)
                    <input type="text" name="frontText" maxlength="32" placeholder="Esi & Kwame" autocomplete="off" />
                  </label>
                  <label class="field" data-front-logo hidden>Your logo (PNG, JPG, SVG or PDF, up to 5 MB)
                    <input type="file" name="logo" accept=".png,.jpg,.jpeg,.svg,.pdf,image/png,image/jpeg,image/svg+xml,application/pdf" />
                    <span class="field__logo" data-logo-preview hidden></span>
                  </label>
                  <label class="field">When is the event? (printed as 12.12.2026)
                    <input type="date" name="eventDate" />
                  </label>
                  <div class="field theme" data-theme>
                    <span>Your event colours (optional, up to 3)</span>
                    <div class="theme__list" data-theme-list></div>
                    <button type="button" class="theme__add" data-theme-add>+ Add a colour</button>
                    <template data-theme-row>
                      <div class="theme__row">
                        <input type="color" class="theme__pick" value="#1B2A4E" />
                        <input type="text" class="theme__hex" value="#1B2A4E" maxlength="7" spellcheck="false" autocomplete="off" inputmode="text" />
                        <button type="button" class="theme__rm">Remove</button>
                      </div>
                    </template>
                  </div>
                  <p class="field__err" data-err="label" hidden></p>
                  <button type="button" class="btn" data-next="label">Continue</button>
                </div>
              </div>
            </section>

            <section class="step" data-step="presentation" aria-labelledby="q-pres">
              <h2 class="step__q" id="q-pres">How should we present each favour?</h2>
              <p class="step__a" data-answer hidden><span data-answer-text></span> <button type="button" class="step__change" data-change>Change</button></p>
              <div class="step__body">
                <div class="tiles" role="radiogroup" aria-labelledby="q-pres">
                  <label class="tile"><input type="radio" name="presentation" value="none" checked /><span><Illus name="pres-none" /><strong>On its own</strong><small>No extra cost</small></span></label>
                  <label class="tile"><input type="radio" name="presentation" value="organza" /><span><Illus name="pres-organza" /><strong>Organza bag</strong><small>+{cedi(ADD_ONS.bag)} each</small></span></label>
                  {p.cardMount && (
                    <label class="tile" data-card-tile><input type="radio" name="presentation" value="card" /><span><Illus name="pres-card" /><strong>Mounted on a card</strong><small data-card-note>+{cedi(ADD_ONS.card)} each{p.cardMountSizes.length < sizes.length ? ` · ${p.cardMountSizes.join(', ')} only` : ''}</small></span></label>
                  )}
                </div>
                {p.cardMount && (
                  <div class="card-opts" data-card-fields hidden>
                    <p class="opts__sub">Pick a card design</p>
                    <div class="tiles">
                      {CARD_DESIGNS.map((d) => (
                        <label class="tile"><input type="radio" name="cardDesign" value={d.name} /><span><Illus name={`design-${d.id}`} /><strong>{d.name}</strong><small>{d.note}</small></span></label>
                      ))}
                    </div>
                    <p class="opts__sub">And the card shape</p>
                    <div class="tiles tiles--small">
                      {CARD_SHAPES.map((s) => (
                        <label class="tile"><input type="radio" name="cardShape" value={s} /><span><Illus name={s === 'Rectangle' ? 'shape-rect' : s === 'Circle' ? 'shape-circle' : 'shape-custom'} /><strong>{s}</strong><small>{s === 'Custom shape' ? `+${cedi(ADD_ONS.shape)} each` : 'Included'}</small></span></label>
                      ))}
                    </div>
                    <p class="field__hint">We design your card to match your label and send it with your label designs.</p>
                    <p class="field__err" data-err="card" hidden></p>
                    <button type="button" class="btn" data-next="presentation">Continue</button>
                  </div>
                )}
              </div>
            </section>

            <section class="step" data-step="tag" aria-labelledby="q-tag">
              <h2 class="step__q" id="q-tag">Add a printed thank-you tag?</h2>
              <p class="step__a" data-answer hidden><span data-answer-text></span> <button type="button" class="step__change" data-change>Change</button></p>
              <div class="step__body opts__row" role="radiogroup" aria-labelledby="q-tag">
                <label class="opt"><input type="radio" name="tag" value="yes" /><span>Yes, add a tag<b>+{cedi(ADD_ONS.tag)} each</b></span></label>
                <label class="opt"><input type="radio" name="tag" value="no" checked /><span>No thanks</span></label>
              </div>
            </section>

            <section class="step" data-step="qty" aria-labelledby="q-qty">
              <h2 class="step__q" id="q-qty">How many pieces do you need?</h2>
              <div class="step__body">
                <div class="qty">
                  <button type="button" class="qty__btn" data-qty="-1" aria-label={`${SITE.qtyStep} fewer`}>−</button>
                  <input type="number" name="qty" min={SITE.minPerItem} step={SITE.qtyStep} value={SITE.minPerItem} inputmode="numeric" aria-label="Number of pieces" />
                  <button type="button" class="qty__btn" data-qty="1" aria-label={`${SITE.qtyStep} more`}>+</button>
                </div>
                <p class="field__hint">Minimum {SITE.minPerItem}, in steps of {SITE.qtyStep}.</p>
                <p class="field__err" data-err="qty" hidden></p>
                <div class="bar" data-price-bar>
                  <p class="bar__price"><span data-unit>{cedi(from)} each</span> · <span data-total>{cedi(from * SITE.minPerItem)} for {SITE.minPerItem}</span></p>
                  <button class="btn" type="submit" data-add>Add to order</button>
                </div>
              </div>
            </section>

            <div class="added" data-added role="status" hidden>
              <p><strong data-added-title>Added to your order.</strong> <span data-added-msg></span></p>
              <div class="btn-row">
                <a class="btn" href={url('/checkout')}>View order</a>
                <a class="btn btn--ghost" href={url('/products')}>Add another product</a>
              </div>
            </div>
          </form>
          <div class="bp card" data-bundle-panel hidden></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--pink">
    <div class="wrap pp__more">
      <div class="prose">
        <h2>Why guests love it</h2>
        {p.longCopy.map((t) => <p>{t}</p>)}
      </div>
      <div class="card">
        <h2>Prices per piece</h2>
        <table class="table">
          <thead><tr><th scope="col">Size</th><th scope="col">Price</th></tr></thead>
          <tbody>{sizes.map((s) => <tr><td>{s.size}</td><td>{cedi(s.price)}</td></tr>)}</tbody>
        </table>
      </div>
    </div>
  </section>

  {p.faqs.length > 0 && (
    <section class="section">
      <div class="wrap">
        <h2>Questions</h2>
        <FaqList faqs={p.faqs} />
      </div>
    </section>
  )}

  <section class="section section--pink">
    <div class="wrap">
      <h2>Bundle it with</h2>
      <p class="lede">Add one more product and save 5% on your whole order.</p>
      <div class="grid grid--3">{others.map((o) => <ProductCard product={o} />)}</div>
    </div>
  </section>
</Base>

<script>
  import { unitPrice, loadCart, saveCart, newId, saveLogo, labelDate, type CartLine } from '../../lib/cart';
  import { cedi } from '../../lib/format';
  import { SITE } from '../../data/site';
  import { getProduct, SUGGESTED_BUNDLES, type Slug } from '../../data/products';
  import { openBundlePanel } from '../../lib/bundlePanel';
  import { getLogo } from '../../lib/cart';
  import { paint } from '../../lib/labelPreview';
  import type { LabelArea } from '../../data/photos';

  const form = document.querySelector<HTMLFormElement>('[data-form]');
  if (form) {
    const slug = form.dataset.slug as Slug;
    const product = getProduct(slug)!;
    const cardSizes: string[] = JSON.parse(form.dataset.cardSizes || '[]');
    const $ = <T extends Element = HTMLElement>(s: string) => form.querySelector<T>(s) ?? document.querySelector<T>(s);
    const checked = (name: string) => form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value;
    const box = (name: string) => !!form.querySelector<HTMLInputElement>(`input[name="${name}"]`)?.checked;
    const field = <T extends HTMLElement = HTMLInputElement>(name: string) => form.querySelector<T>(`[name="${name}"]`);

    const qtyInput = field('qty')!;
    const dateInput = field('eventDate')!;
    const textInput = field('frontText')!;
    const fileInput = field('logo')!;
    let logoFile: File | null = null;
    let logoImg: HTMLImageElement | null = null;

    // Event date cannot be in the past
    const today = new Date();
    dateInput.min = new Date(today.getTime() - today.getTimezoneOffset() * 60000).toISOString().slice(0, 10);

    function read() {
      const pres = checked('presentation') || 'none';
      const card = pres === 'card';
      return {
        size: checked('size')!,
        scent: checked('scent'),
        shade: checked('shade'),
        container: checked('container')!,
        lid: form.querySelector<HTMLInputElement>('input[name="lid"]:checked:not(:disabled)')?.value,
        pack: checked('packaging'),
        label: checked('label') === 'yes',
        front: (checked('front') as 'text' | 'logo') || 'text',
        themeColours: Array.from(form.querySelectorAll<HTMLInputElement>('.theme__hex'))
          .map((i) => i.value.trim().toUpperCase())
          .filter((v) => /^#[0-9A-F]{6}$/.test(v)),
        frontText: textInput.value.trim(),
        eventDate: dateInput.value,
        pres,
        bag: pres === 'organza',
        card,
        cardShape: card ? checked('cardShape') : undefined,
        cardDesign: card ? checked('cardDesign') : undefined,
        tag: checked('tag') === 'yes',
        qty: Number(qtyInput.value) || 0,
      };
    }

    // ---- live UI -------------------------------------------------------------
    function syncPackaging() {
      const pack = checked('packaging');
      if (!pack) return;
      const q = form.querySelector<HTMLElement>('[data-colour-q]');
      if (q) q.textContent = `Which ${pack.toLowerCase()} colour?`;
      form.querySelectorAll<HTMLFieldSetElement>('[data-for-pack]').forEach((fs) => {
        const on = fs.dataset.forPack === pack;
        fs.hidden = !on;
        fs.querySelectorAll<HTMLInputElement>('input[name="lid"]').forEach((i) => (i.disabled = !on));
      });
      const current = form.querySelector<HTMLInputElement>('input[name="container"]:checked');
      if (!current || current.dataset.pack !== pack) {
        const first = form.querySelector<HTMLInputElement>(`input[name="container"][data-pack="${pack}"]:not(:disabled)`);
        if (first) first.checked = true;
      }
    }

    function refresh(debounce = false) {
      syncPackaging();
      const o = read();
      // photo of the chosen packaging, when we have one
      const shots = document.querySelectorAll<HTMLElement>('[data-shot]');
      const match = Array.from(shots).find((s) => s.dataset.shot === o.container);
      shots.forEach((s) => s.classList.toggle('is-on', match ? s === match : s.dataset.shot === ''));
      const style = form.querySelector<HTMLInputElement>('input[name="container"]:checked')?.dataset.labelStyle || 'wrap';
      // label printed on the packaging photo, inside the marked area
      let painted = false;
      shots.forEach((s) => {
        const cv = s.querySelector<HTMLCanvasElement>('canvas.pp__paint');
        const img = s.querySelector<HTMLImageElement>('img');
        if (!cv || !img) return;
        const show = o.label && s === match && !!s.dataset.area;
        if (show) {
          const draw = () => {
            paint(cv, img, JSON.parse(s.dataset.area!) as LabelArea, {
              text: o.front === 'text' ? o.frontText : '',
              logo: o.front === 'logo' ? logoImg : null,
              date: labelDate(o.eventDate),
            });
            cv.hidden = false;
            img.style.visibility = 'hidden';
          };
          img.loading = 'eager';
          if (img.complete && img.naturalWidth) draw();
          else img.addEventListener('load', draw, { once: true });
          painted = true;
        } else {
          cv.hidden = true;
          img.style.visibility = '';
        }
      });
      // dependent fields
      $('[data-label-fields]')!.hidden = !o.label;
      $('[data-front-text]')!.hidden = o.front !== 'text';
      $('[data-front-logo]')!.hidden = o.front !== 'logo';
      const cardInput = form.querySelector<HTMLInputElement>('input[name="presentation"][value="card"]');
      if (cardInput) {
        const allowed = !o.size || cardSizes.includes(o.size);
        cardInput.disabled = !allowed;
        cardInput.closest('.tile')!.classList.toggle('is-disabled', !allowed);
        $('[data-card-fields]')!.hidden = checked('presentation') !== 'card';
      }
      // label preview (HTML, always available)
      const lp = $('[data-labelprev]')!;
      lp.hidden = !o.label || painted;
      $('[data-lpcap]')!.hidden = !o.label || painted;
      lp.dataset.style = style;
      const lpFront = $('[data-lp-front]')!;
      if (o.front === 'logo' && logoImg) {
        lpFront.replaceChildren(logoImg.cloneNode());
      } else if (o.front === 'logo' && logoFile) {
        lpFront.textContent = logoFile.name;
      } else {
        lpFront.textContent = o.frontText || 'Your names';
      }
      lpFront.classList.toggle('is-empty', o.front === 'text' && !o.frontText);
      $('[data-lp-date]')!.textContent = labelDate(o.eventDate);
      // price bar
      const final = read();
      const unit = unitPrice(slug, final);
      flow?.updateAnswers();
      const qty = Math.max(final.qty, 0);
      $('[data-unit]')!.textContent = `${cedi(unit)} each`;
      $('[data-total]')!.textContent = `${cedi(unit * qty)} for ${qty}`;
      $('[data-added]')!.hidden = true;
    }

    // ---- guided flow: one question at a time ------------------------------------
    const flow = (() => {
      const steps = Array.from(form.querySelectorAll<HTMLElement>('[data-step]'));
      if (!steps.length) return null;
      form.classList.add('is-guided');
      // Nothing is pre-chosen: the customer answers each question.
      ['size', 'shade', 'scent', 'packaging', 'container', 'lid', 'label', 'presentation', 'cardDesign', 'cardShape', 'tag']
        .forEach((n) => form.querySelectorAll<HTMLInputElement>(`input[name="${n}"]`).forEach((i) => (i.checked = false)));
      const done = new Set<string>();
      let open = steps[0].dataset.step!;
      const id = (s: HTMLElement) => s.dataset.step!;
      const stepEl = (k: string) => steps.find((s) => id(s) === k);

      function answer(k: string) {
        const o = read();
        switch (k) {
          case 'size': return o.size;
          case 'scent': return o.scent;
          case 'shade': return o.shade;
          case 'packaging': return o.pack;
          case 'colour': {
            const c = form.querySelector<HTMLInputElement>('input[name="container"]:checked');
            return c ? [c.dataset.colour, o.lid && `${o.lid} lid`].filter(Boolean).join(', ') : '';
          }
          case 'label':
            if (!o.label) return 'No label';
            return [o.front === 'logo' ? `Logo${logoFile ? `: ${logoFile.name}` : ''}` : o.frontText, labelDate(o.eventDate)].filter(Boolean).join(' · ');
          case 'presentation':
            return o.pres === 'organza' ? 'Organza bag' : o.pres === 'card' ? ['Card', o.cardDesign, o.cardShape].filter(Boolean).join(' · ') : 'On its own';
          case 'tag': return o.tag ? 'Thank-you tag' : 'No tag';
        }
        return '';
      }

      function render(scroll = false) {
        steps.forEach((s) => {
          const k = id(s);
          const isOpen = k === open;
          s.hidden = !(isOpen || done.has(k));
          s.classList.toggle('is-open', isOpen);
          s.classList.toggle('is-done', done.has(k) && !isOpen);
          const a = s.querySelector<HTMLElement>('[data-answer]');
          if (a) {
            a.hidden = isOpen || !done.has(k);
            a.querySelector('[data-answer-text]')!.textContent = answer(k) || '';
          }
        });
        if (scroll) {
          const el = stepEl(open);
          if (el) requestAnimationFrame(() => el.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' }));
        }
      }

      function complete(k: string) {
        done.add(k);
        const i = steps.findIndex((s) => id(s) === k);
        const next = steps.slice(i + 1).find((s) => !done.has(id(s))) ?? steps.find((s) => !done.has(id(s)));
        open = next ? id(next) : 'qty';
        render(true);
      }

      function undo(k: string) {
        done.delete(k);
      }

      steps.forEach((s) => s.querySelector('[data-change]')?.addEventListener('click', () => {
        open = id(s);
        render(true);
      }));

      // Answer handling: most questions move on as soon as they are answered.
      form.addEventListener('change', (e) => {
        const n = (e.target as HTMLInputElement).name;
        const o = read();
        if (n === 'cardDesign' || n === 'cardShape') $('[data-err="card"]')!.hidden = true;
        if (n === 'size') {
          // a card is only possible for some sizes: if it no longer fits, ask again
          const card = form.querySelector<HTMLInputElement>('input[name="presentation"][value="card"]');
          if (card?.checked && !cardSizes.includes(o.size)) {
            card.checked = false;
            done.delete('presentation');
          }
        }
        if (n === 'size' || n === 'shade' || n === 'scent' || n === 'tag') complete(n);
        if (n === 'packaging') {
          form.querySelectorAll<HTMLInputElement>('input[name="container"], input[name="lid"]').forEach((i) => (i.checked = false));
          done.delete('colour');
          complete('packaging');
        }
        if (n === 'container' || n === 'lid') {
          const needsLid = !!form.querySelector('input[name="lid"]:not(:disabled)');
          if (checked('container') && (!needsLid || o.lid)) complete('colour');
        }
        if (n === 'label' && !o.label) complete('label');
        if (n === 'presentation' && o.pres !== 'card') complete('presentation');
      });

      form.querySelectorAll<HTMLButtonElement>('[data-next]').forEach((b) => b.addEventListener('click', () => {
        const k = b.dataset.next!;
        const o = read();
        if (k === 'label') {
          $('[data-err="label"]')!.hidden = true;
          if (o.front === 'text' && !o.frontText) return showErr('label', 'Please type the names or text for your label.', textInput);
          if (o.front === 'logo' && !logoFile) return showErr('label', 'Please upload your logo.', fileInput);
          if (!o.eventDate) return showErr('label', 'Please choose your event date.', dateInput);
        }
        if (k === 'presentation') {
          $('[data-err="card"]')!.hidden = true;
          if (!o.cardDesign) return showErr('card', 'Please pick a card design.');
          if (!o.cardShape) return showErr('card', 'Please pick a card shape.');
        }
        complete(k);
      }));

      render();
      return {
        fillAll: () => { steps.forEach((s) => { if (id(s) !== 'qty') done.add(id(s)); }); open = 'qty'; render(); },
        updateAnswers: () => render(),
        undo,
        firstMissing: () => steps.find((s) => id(s) !== 'qty' && !done.has(id(s))),
        openStep: (k: string) => { open = k; render(true); },
      };
    })();

    form.addEventListener('change', (e) => {
      if ((e.target as HTMLElement).getAttribute('name') === 'qty') normaliseQty();
      refresh();
    });
    form.addEventListener('input', (e) => {
      const n = (e.target as HTMLElement).getAttribute('name');
      if (n === 'frontText' || n === 'qty') refresh(true);
    });

    function normaliseQty() {
      let q = Number(qtyInput.value) || SITE.minPerItem;
      q = Math.max(SITE.minPerItem, Math.ceil(q / SITE.qtyStep) * SITE.qtyStep);
      qtyInput.value = String(q);
    }
    form.querySelectorAll<HTMLButtonElement>('[data-qty]').forEach((b) =>
      b.addEventListener('click', () => {
        const q = (Number(qtyInput.value) || SITE.minPerItem) + Number(b.dataset.qty) * SITE.qtyStep;
        qtyInput.value = String(Math.max(SITE.minPerItem, q));
        refresh();
      }),
    );

    // ---- event theme colours (up to 3, colour picker + hex code) ----------------
    const themeList = $('[data-theme-list]')!;
    const themeAdd = $<HTMLButtonElement>('[data-theme-add]')!;
    const themeTpl = $<HTMLTemplateElement>('[data-theme-row]')!;
    const syncThemeUi = () => {
      const rows = themeList.querySelectorAll('.theme__row');
      themeAdd.hidden = rows.length >= 3;
      rows.forEach((r, i) => {
        r.querySelector('.theme__pick')!.setAttribute('aria-label', `Theme colour ${i + 1}`);
        r.querySelector('.theme__hex')!.setAttribute('aria-label', `Hex code for colour ${i + 1}`);
      });
    };
    themeAdd.addEventListener('click', () => {
      if (themeList.children.length >= 3) return;
      const row = themeTpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
      const pick = row.querySelector<HTMLInputElement>('.theme__pick')!;
      const hex = row.querySelector<HTMLInputElement>('.theme__hex')!;
      pick.addEventListener('input', () => { hex.value = pick.value.toUpperCase(); hex.classList.remove('is-bad'); refresh(); });
      hex.addEventListener('input', () => {
        let v = hex.value.trim();
        if (v && v[0] !== '#') v = '#' + v;
        const ok = /^#[0-9a-fA-F]{6}$/.test(v);
        hex.classList.toggle('is-bad', !ok && v.length >= 7);
        if (ok) { pick.value = v.toLowerCase(); refresh(); }
      });
      hex.addEventListener('blur', () => { if (hex.value && hex.value[0] !== '#') hex.value = '#' + hex.value; hex.value = hex.value.toUpperCase(); });
      row.querySelector('.theme__rm')!.addEventListener('click', () => { row.remove(); syncThemeUi(); refresh(); });
      themeList.appendChild(row);
      syncThemeUi();
      refresh();
      hex.focus();
    });

    fileInput.addEventListener('change', () => {
      const f = fileInput.files?.[0] || null;
      const err = $('[data-err="label"]')!;
      err.hidden = true;
      logoFile = null;
      logoImg = null;
      const prev = $('[data-logo-preview]')!;
      prev.hidden = true;
      if (!f) return refresh();
      const okType = /\.(png|jpe?g|svg|pdf)$/i.test(f.name);
      if (!okType || f.size > 5 * 1024 * 1024) {
        err.textContent = !okType ? 'Please choose a PNG, JPG, SVG or PDF file.' : 'That file is over 5 MB. Please choose a smaller one.';
        err.hidden = false;
        fileInput.value = '';
        return refresh();
      }
      logoFile = f;
      if (/\.pdf$/i.test(f.name)) {
        prev.textContent = `${f.name} (PDF: we will place it on your label)`;
        prev.hidden = false;
        return refresh();
      }
      const img = new Image();
      img.alt = 'Your logo';
      img.onload = () => { logoImg = img; prev.replaceChildren(img.cloneNode()); prev.hidden = false; refresh(); };
      img.src = URL.createObjectURL(f);
    });

    // ---- add to order --------------------------------------------------------
    function showErr(which: string, msg: string, focus?: HTMLElement) {
      const el = $(`[data-err="${which}"]`)!;
      el.textContent = msg;
      el.hidden = false;
      focus?.focus();
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      form.querySelectorAll<HTMLElement>('[data-err]').forEach((el) => (el.hidden = true));
      normaliseQty();
      const missing = flow?.firstMissing();
      if (missing) {
        flow!.openStep(missing.dataset.step!);
        return;
      }
      const o = read();
      if (o.label) {
        if (o.front === 'text' && !o.frontText) return showErr('label', 'Please type the names or text for the front of your label.', textInput);
        if (o.front === 'logo' && !logoFile) return showErr('label', 'Please upload your logo.', fileInput);
        if (!o.eventDate) return showErr('label', 'Please choose your event date for the label.', dateInput);
      }
      const id = editing?.id ?? newId();
      const line: CartLine = {
        id, slug, qty: o.qty, size: o.size, shade: o.shade, scent: o.scent, container: o.container, lid: o.lid,
        label: o.label,
        front: o.label ? o.front : undefined,
        frontText: o.label && o.front === 'text' ? o.frontText : undefined,
        logoName: o.label && o.front === 'logo' ? logoFile?.name : undefined,
        eventDate: o.label ? o.eventDate : undefined,
        themeColours: o.label && o.themeColours.length ? o.themeColours : undefined,
        bag: o.bag,
        card: o.card, cardShape: o.card ? o.cardShape : undefined, cardDesign: o.card ? o.cardDesign : undefined,
        tag: o.tag,
      };
      if (line.logoName && logoFile) await saveLogo(id, logoFile);
      const cart = loadCart();
      const at = editing ? cart.findIndex((l) => l.id === editing!.id) : -1;
      if (at >= 0) cart[at] = line; else cart.push(line);
      saveCart(cart);
      const unit = unitPrice(slug, line);
      $('[data-added-title]')!.textContent = editing ? 'Your order is updated.' : 'Added to your order.';
      $('[data-added-msg]')!.textContent = `${line.qty} × ${product.shortName} · ${cedi(unit * line.qty)}`;
      const added = $('[data-added]')!;
      added.hidden = false;
      if (!editing) {
        const panel = document.querySelector<HTMLElement>('[data-bundle-panel]')!;
        const pre = bundle ? bundle.items.filter((i) => i.slug !== slug) : [];
        openBundlePanel(panel, line, pre);
        if (panel.hidden) added.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } else added.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });

    // ---- suggested bundle (?bundle=...) and editing a line (?edit=...) ---------
    const params = new URLSearchParams(location.search);
    const bundle = SUGGESTED_BUNDLES.find((b) => b.id === params.get('bundle'));
    const editing = loadCart().find((l) => l.id === params.get('edit') && l.slug === slug);
    if (bundle) {
      const intro = form.querySelector<HTMLElement>('.flow__intro');
      if (intro) intro.textContent = `Let's start ${bundle.name} with your ${product.shortName}. We'll add the rest right after.`;
    }
    if (editing) {
      const tick = (name: string, value?: string) => {
        if (value === undefined) return;
        const i = form.querySelector<HTMLInputElement>(`input[name="${name}"][value="${CSS.escape(value)}"]`);
        if (i) i.checked = true;
      };
      tick('size', editing.size);
      tick('shade', editing.shade);
      tick('scent', editing.scent);
      tick('packaging', editing.container.split(' · ')[0]);
      syncPackaging();
      tick('container', editing.container);
      tick('lid', editing.lid);
      tick('label', editing.label ? 'yes' : 'none');
      tick('front', editing.front || 'text');
      textInput.value = editing.frontText || '';
      dateInput.value = editing.eventDate || '';
      (editing.themeColours || []).forEach((hex) => {
        themeAdd.click();
        const h = themeList.lastElementChild!.querySelector<HTMLInputElement>('.theme__hex')!;
        h.value = hex;
        h.dispatchEvent(new Event('input'));
      });
      tick('presentation', editing.card ? 'card' : editing.bag ? 'organza' : 'none');
      tick('cardDesign', editing.cardDesign);
      tick('cardShape', editing.cardShape);
      tick('tag', editing.tag ? 'yes' : 'no');
      qtyInput.value = String(editing.qty);
      if (editing.logoName) {
        getLogo(editing.id).then((blob) => {
          if (!blob) return;
          logoFile = new File([blob], editing.logoName!, { type: blob.type });
          const prev = $('[data-logo-preview]')!;
          if (blob.type.startsWith('image/')) {
            const img = new Image();
            img.onload = () => { logoImg = img; prev.replaceChildren(img.cloneNode()); prev.hidden = false; refresh(); };
            img.src = URL.createObjectURL(blob);
          } else { prev.textContent = editing.logoName!; prev.hidden = false; refresh(); }
        });
      }
      flow?.fillAll();
      const intro = form.querySelector<HTMLElement>('.flow__intro');
      if (intro) intro.textContent = 'Editing your order. Change anything below, then save.';
      $('[data-add]')!.textContent = 'Save changes';
    }

    refresh();
  }
</script>

