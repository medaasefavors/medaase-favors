---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Steps from '../components/Steps.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../data/site';
import { BUNDLE_DISCOUNT } from '../data/products';
import { url } from '../lib/url';
import { breadcrumbs } from '../lib/schema';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'How it works', path: '/how-it-works' }];
---
<Base title="How Ordering Souvenirs Works | Medaase Favors" description="Choose your favours, pay online with MoMo or card, approve your free label design on WhatsApp, then collect in 5 to 7 working days." path="/how-it-works" schema={[breadcrumbs(crumbs)]}>
  <section class="section">
    <span class="ghost-word" aria-hidden="true">EASY</span>
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <h1>How it works</h1>
      <p class="lede">Four steps from idea to thank you.</p>
      <h2 class="sr-only">The four steps</h2>
      <Steps />
    </div>
  </section>
  <section class="section section--pink">
    <div class="wrap grid grid--2">
      <div>
        <h2>Bundle and save</h2>
        <p>Order two or more different products and get {Math.round(BUNDLE_DISCOUNT * 100)}% off your whole order.</p>
      </div>
      <div>
        <h2>Short on time?</h2>
        <p>Under {SITE.rushWorkingDays} working days to your event: {Math.round(SITE.rushRate * 100)}% rush fee. Under {SITE.blockWorkingDays}: <a href={url('/contact')}>message us first</a>.</p>
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
