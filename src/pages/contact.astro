---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE, whatsappLink } from '../data/site';
import { breadcrumbs } from '../lib/schema';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact' }];
---
<Base title="Contact Medaase Favors | Souvenirs in Accra" description="Message Medaase Favors on WhatsApp, email or Instagram about custom souvenirs for your event in Accra and across Ghana." path="/contact" schema={[breadcrumbs(crumbs)]}>
  <section class="section">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <h1>Say hello</h1>
      <p class="lede">Questions about your event, a big order or a tight date? Message us. A real person answers, usually the same day.</p>
      <div class="grid grid--3">
        <div class="card">
          <h2 style="font-size:1.5rem">WhatsApp</h2>
          <p>The fastest way to reach us, and where we send your label design.</p>
          <a class="btn" href={whatsappLink()} rel="noopener">Chat on WhatsApp</a>
        </div>
        <div class="card">
          <h2 style="font-size:1.5rem">Email</h2>
          <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        </div>
        <div class="card">
          <h2 style="font-size:1.5rem">Instagram</h2>
          <p>See our latest favours and DM us to order.</p>
          <p><a href={SITE.instagram} rel="noopener">{SITE.instagramHandle}</a></p>
        </div>
      </div>
      <div class="card" style="margin-top:28px">
        <h2 style="font-size:1.5rem">Pickup and hours</h2>
        <p>Pickup area: {SITE.pickupArea}. We share the exact pickup point when your order is ready.</p>
        <p>Hours: {SITE.businessHours}.</p>
      </div>
    </div>
  </section>
</Base>
