---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE, emailLink } from '../data/site';
import { cedi } from '../lib/format';
import { breadcrumbs } from '../lib/schema';
import { url } from '../lib/url';
import catalogue from '../data/catalogue.json';
const docs = (catalogue.documents ?? []).filter((d) => d.show !== false && d.file);
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact' }];
---
<Base title="Contact Medaase Favors | Custom Souvenirs in Ghana" description="Email Medaase Favors about custom souvenirs for your event. Office hours, pickup times and delivery across Ghana." path="/contact" schema={[breadcrumbs(crumbs)]}>
  <section class="section">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <h1>Contact</h1>
      <p class="lede">Questions about your event, a big order or a tight date? Email us.</p>
      <div class="grid grid--2">
        <div class="card">
          <h2 style="font-size:1.5rem">Email</h2>
          <p><a href={emailLink()}>{SITE.email}</a></p>
          <p>Office hours: {SITE.businessHours}.</p>
        </div>
        <div class="card">
          <h2 style="font-size:1.5rem">Instagram</h2>
          <p><a href={SITE.instagram} rel="noopener">{SITE.instagramHandle}</a></p>
        </div>
        <div class="card">
          <h2 style="font-size:1.5rem">Pickup</h2>
          <p>Free. {SITE.pickupHours}. No pickups on weekends or outside these hours.</p>
        </div>
        <div class="card">
          <h2 style="font-size:1.5rem">Delivery</h2>
          <p>Within Accra: {SITE.deliveryAccra}.<br />Outside Accra: {cedi(SITE.deliveryFeeOutsideAccra)} flat.</p>
        </div>
      </div>
      {docs.length > 0 && (
        <div class="card" style="margin-top:28px">
          <h2 style="font-size:1.5rem">Downloads</h2>
          <ul>{docs.map((d) => <li><a href={url(`/docs/${d.file}`)} download>{d.title}</a> (PDF)</li>)}</ul>
        </div>
      )}
    </div>
  </section>
</Base>
