---
// Hidden page: not in the menu, footer or sitemap, and not indexed by search engines.
// Share the link privately with clients who want a special card design.
import Base from '../layouts/Base.astro';
import { CARD_STYLES } from '../data/cardStyles';
import { url } from '../lib/url';
---
<Base title="Card styles | Medaase Favors" description="Card mounting styles for Medaase Favors souvenirs." path="/card-styles" noindex>
  <section class="section">
    <div class="wrap">
      <h1>Card styles</h1>
      <p class="lede">Our standard card is simple and clean, with your names, the date and a short message. Want something more special? Choose a style below and tell us its number in the special style box when you order, or mention it on WhatsApp.</p>
      <div class="cs">
        {CARD_STYLES.map((s) => (
          <article class="cs__item">
            <div class="cs__img">
              <span class="cs__ph">{s.name}</span>
              <img src={url(`/card-styles/${String(s.num).padStart(2, '0')}.jpg`)} alt={`Card style ${s.num}: ${s.name}`} loading="lazy" onerror="this.remove()" />
              <span class="cs__num">{s.num}</span>
            </div>
            <h2>{s.name}</h2>
            <p>{s.description}</p>
            <dl>
              <dt>Works with</dt><dd>{s.worksWith}</dd>
              <dt>Best for</dt><dd>{s.bestFor}</dd>
            </dl>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .cs { display: grid; gap: 28px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); margin-top: 28px; }
  .cs__img { position: relative; aspect-ratio: 4 / 5; border-radius: 24px; overflow: hidden; background: #FFF0F5; display: grid; place-items: center; margin-bottom: 14px; }
  .cs__img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .cs__ph { font-family: 'Young Serif', Georgia, serif; font-size: 1.4rem; color: #1B2A4E; opacity: .55; padding: 20px; text-align: center; }
  .cs__num { position: absolute; top: 12px; left: 12px; width: 52px; height: 52px; border-radius: 50%; background: #FFB8D1; color: #1B2A4E; display: grid; place-items: center; font-family: 'Young Serif', Georgia, serif; font-size: 1.6rem; box-shadow: 0 4px 14px #0002; }
  .cs__item h2 { font-size: 1.4rem; margin: 0 0 6px; }
  .cs__item p { margin: 0 0 8px; }
  .cs__item dl { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 4px 12px; margin: 0; font-size: .95rem; }
  .cs__item dt { font-weight: 700; }
  .cs__item dd { margin: 0; opacity: .8; }
</style>
