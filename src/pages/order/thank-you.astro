---
import Base from '../../layouts/Base.astro';
import { SITE, designRoundsText } from '../../data/site';
---
<Base title="Thank you for your order | Medaase Favors" description="Your Medaase Favors order is confirmed." path="/order/thank-you" noindex>
  <section class="section">
    <div class="wrap">
      <h1>Medaase! Your order is in.</h1>
      <p class="lede">Your reference: <strong data-ref>shown in your confirmation email</strong></p>
      <div class="card">
        <h2 style="font-size:1.5rem">What happens next</h2>
        <ol>
          <li>Within 24 hours we email you two label designs to choose from.</li>
          <li>You get {designRoundsText()} for free.</li>
          <li>Your favours are ready {SITE.turnaround} after you approve.</li>
        </ol>
        <div class="btn-row">
          <a class="btn" href={SITE.instagram} rel="noopener">Follow {SITE.instagramHandle}</a>
        </div>
      </div>
    </div>
  </section>
  <script is:inline>
    (function () {
      var ref = new URLSearchParams(location.search).get('ref');
      if (ref && /^MF-[A-Z0-9-]+$/i.test(ref)) document.querySelector('[data-ref]').textContent = ref;
    })();
  </script>
</Base>
