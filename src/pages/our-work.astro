---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import { Picture } from 'astro:assets';
import { WORKS } from '../data/photos';
import { getProduct } from '../data/products';
import { SITE } from '../data/site';
import { url } from '../lib/url';
import { breadcrumbs } from '../lib/schema';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Our work', path: '/our-work' }];
---
<Base
  title="Our Work: Custom Souvenirs We've Made | Medaase Favors"
  description="Real custom souvenirs from Medaase Favors: bride squad lip balms, thank you cards, bridal shower favours and pure shea butter, made in Accra."
  path="/our-work"
  schema={[breadcrumbs(crumbs)]}
>
  <section class="section">
    <span class="ghost-word" aria-hidden="true">MEDAASE</span>
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <h1>Our work</h1>
      <p class="lede">Real favours we have made for real celebrations. Every one starts with a name, a date and a theme, and ends up in a guest's handbag.</p>

      <ul class="works">
        {WORKS.map((w, i) => {
          const p = getProduct(w.product)!;
          return (
            <li class:list={['work', { 'work--wide': i === 0 }]}>
              <figure>
                <Picture src={w.photo.src} alt={w.photo.alt} formats={['avif', 'webp']} widths={[360, 600, 900]} sizes="(min-width: 1000px) 33vw, (min-width: 640px) 50vw, 100vw" loading={i < 2 ? 'eager' : 'lazy'} class="work__img" />
                <figcaption>
                  <span class="work__tag">{w.occasion}</span>
                  <h2 class="work__title">{w.title}</h2>
                  <p>{w.note}</p>
                  <a href={url(`/products/${p.slug}`)}>{p.shortName} →</a>
                </figcaption>
              </figure>
            </li>
          );
        })}
      </ul>
      <p class="works__more">More on Instagram: <a href={SITE.instagram} rel="noopener">{SITE.instagramHandle}</a></p>
    </div>
  </section>
  <CtaBand title="Want one like these?" text="Tell us your names, date and colours, and we will design your favours for free." />
</Base>

<style>
  .works {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
    display: grid;
    gap: clamp(16px, 2.5vw, 28px);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr));
  }
  .work figure {
    margin: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: transform 0.25s ease;
  }
  .work figure:hover {
    transform: translateY(-4px);
  }
  .work :global(.work__img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .work figcaption {
    padding: 18px 20px 22px;
  }
  .work__tag {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--navy);
    background: var(--pink-soft);
    border-radius: 999px;
    padding: 4px 10px;
    margin-bottom: 10px;
  }
  .work__title {
    font-size: 1.4rem;
    margin-bottom: 6px;
  }
  .work p {
    color: var(--muted);
    margin-bottom: 10px;
  }
  .work a {
    font-weight: 700;
    text-decoration: none;
  }
  .work a:hover {
    text-decoration: underline;
  }
  .works__more {
    margin-top: 32px;
    font-weight: 500;
  }
  @media (min-width: 900px) {
    .work--wide {
      grid-column: span 2;
    }
    .work--wide :global(.work__img) {
      aspect-ratio: 16 / 10;
    }
  }
</style>
