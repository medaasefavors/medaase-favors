---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import { GUIDES, type Guide } from '../../data/guides';
import { SITE } from '../../data/site';
import { absolute, url } from '../../lib/url';
import { breadcrumbs } from '../../lib/schema';
export function getStaticPaths() {
  return GUIDES.map((g) => ({ params: { slug: g.slug }, props: { g } }));
}
const { g } = Astro.props as { g: Guide };
const path = `/guides/${g.slug}`;
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Guides', path: '/guides' }, { name: g.title, path }];
const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: g.title,
  description: g.metaDescription,
  datePublished: g.published,
  dateModified: g.published,
  inLanguage: SITE.locale,
  image: [absolute('/og/default.png')],
  author: { '@type': 'Organization', name: SITE.name, url: absolute('/') },
  publisher: { '@id': absolute('/') + '#organization' },
  mainEntityOfPage: absolute(path),
};
const date = new Date(g.published).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={g.metaTitle} description={g.metaDescription} path={path} schema={[article, breadcrumbs(crumbs)]} ogType="article">
  <article class="section">
    <div class="wrap prose">
      <Breadcrumbs items={crumbs} />
      <h1 style="font-size:clamp(2rem,5vw,3.2rem)">{g.title}</h1>
      <p><time datetime={g.published}>{date}</time> · {SITE.name}</p>
      <p class="lede">{g.intro}</p>
      {g.sections.map((s) => (
        <>
          <h2>{s.h}</h2>
          {s.p?.map((t) => <p>{t}</p>)}
          {s.list && <ul>{s.list.map((l) => <li>{l}</li>)}</ul>}
        </>
      ))}
      <p><a class="btn" href={url(g.cta.path)}>{g.cta.text}</a></p>
    </div>
  </article>
  <CtaBand />
</Base>
